// redjelly UI. Rust owns all state and focus: every key goes to `key`, which
// maps it to an Action and updates the properties below (SPEC §4.1). Slint
// only renders what it is given, so focus can never get lost in the UI.

import { LineEdit, Button } from "std-widgets.slint";

// Sizes here must match src/layout.rs, which computes scrolling.
global Theme {
    out property <color> bg: #0e0e12;
    out property <color> card: #1c1c23;
    out property <color> card-focus: #2b2b35;
    out property <color> accent: #e5484d;
    out property <color> text: #f4f4f5;
    out property <color> muted: #a1a1aa;
    out property <length> side-pad: 48px;
    out property <length> gap: 16px;
}

export struct Card {
    title: string,
    subtitle: string,
    image: image,
    has-image: bool,
    /// 0..1 resume position, negative = none.
    progress: float,
    played: bool,
    /// Setting cards: 0 = plain, 1 = selected / included, 2 = excluded.
    /// Image cards: 2 = unavailable (dimmed), 3 = live.
    mark: int,
}

/// style: 0 = poster (2:3), 1 = wide (16:9), 2 = button, 3 = setting
/// (label + value), 4 = compact button (only for `pinned` cards).
export struct Row {
    title: string,
    style: int,
    cards: [Card],
    /// Horizontal scroll, in cards.
    scroll: int,
    /// Trailing cards drawn as compact buttons (style 4) at the right edge.
    pinned: int,
}

export struct Header {
    title: string,
    meta: string,
    info: string,
    overview: string,
    backdrop: image,
    has-backdrop: bool,
}

/// One line in the subtitle panel. Headers are not selectable.
export struct PanelItem {
    title: string,
    detail: string,
    badge: string,
    header: bool,
    dimmed: bool,
}

export struct KeyHelp {
    key: string,
    action: string,
}

component CardView inherits Rectangle {
    in property <Card> card;
    in property <int> style;
    in property <bool> focused;
    callback clicked();

    property <length> img-w: style == 1 ? 288px : 160px;
    property <length> img-h: style == 1 ? 162px : 240px;
    width: style == 2 ? 220px : style == 3 ? 300px : style == 4 ? 112px : img-w;
    height: style == 2 || style == 4 ? 56px : style == 3 ? 72px : img-h + 52px;

    if root.style == 3: Rectangle {
        border-radius: 8px;
        background: root.focused ? Theme.accent : Theme.card;
        animate background { duration: 90ms; }
        // Selection stripe: green = chosen / included, grey = excluded.
        if root.card.mark > 0: Rectangle {
            x: 0;
            width: 6px;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
            background: root.card.mark == 1 ? #46a758 : #71717a;
        }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: center;
            spacing: 4px;
            Text {
                text: root.card.title;
                color: root.focused ? #ffffffd0 : Theme.muted;
                font-size: 13px;
                overflow: elide;
            }
            Text {
                text: root.card.subtitle;
                color: Theme.text;
                font-size: 17px;
                font-weight: 600;
                overflow: elide;
            }
        }
    }

    if root.style == 2 || root.style == 4: Rectangle {
        border-radius: 8px;
        background: root.focused ? Theme.accent : Theme.card;
        animate background { duration: 90ms; }
        Text {
            width: parent.width - 16px;
            text: root.card.title;
            color: Theme.text;
            font-size: root.style == 4 ? 15px : 17px;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    if root.style < 2: VerticalLayout {
        spacing: 8px;
        Rectangle {
            width: root.img-w;
            height: root.img-h;
            border-radius: 8px;
            clip: true;
            background: root.focused ? Theme.card-focus : Theme.card;

            if !root.card.has-image: Text {
                width: parent.width - 24px;
                text: root.card.title;
                color: Theme.muted;
                font-size: 16px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            if root.card.has-image: Image {
                width: parent.width;
                height: parent.height;
                source: root.card.image;
                image-fit: cover;
            }
            if root.card.progress >= 0: Rectangle {
                y: parent.height - 5px;
                height: 5px;
                background: #00000099;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.card.progress, 0, 1);
                    background: Theme.accent;
                }
            }
            if root.card.played: Rectangle {
                x: parent.width - 32px;
                y: 8px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.accent;
                Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    commands: "M 2 7 L 6 11 L 12 3";
                    stroke: white;
                    stroke-width: 2.5px;
                }
            }
            // Can't play here (DRM off Windows, not online): dimmed.
            if root.card.mark == 2: Rectangle {
                background: #000000a0;
            }
            if root.card.mark == 3: Rectangle {
                x: 8px;
                y: 8px;
                width: live-text.preferred-width + 12px;
                height: 20px;
                border-radius: 4px;
                background: #e5484d;
                live-text := Text {
                    text: "LIVE";
                    color: white;
                    font-size: 11px;
                    font-weight: 700;
                }
            }
            // Focus ring drawn last so it sits above the image.
            Rectangle {
                border-radius: 8px;
                border-width: root.focused ? 3px : 0px;
                border-color: white;
            }
        }
        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.card.title;
                color: root.focused ? Theme.text : #d4d4d8;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.card.subtitle;
                color: Theme.muted;
                font-size: 13px;
                overflow: elide;
            }
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

/// Every browse-type screen: optional header plus rows of cards.
component BrowseView inherits Rectangle {
    in property <Header> header;
    in property <bool> header-visible;
    in property <[Row]> rows;
    in property <int> focus-row;
    in property <int> focus-col;
    /// Vertical scroll of the rows area, computed in Rust.
    in property <length> scroll-y;
    /// Offset keeping the row above the focused one in view; scrolling
    /// stays between it and `scroll-y` so the focused row (bottom edge
    /// `focus-bottom`) is always whole.
    in property <length> scroll-peek;
    in property <length> focus-bottom;
    callback card-clicked(int, int);

    if root.header.has-backdrop: Image {
        width: parent.width;
        height: parent.height;
        source: root.header.backdrop;
        image-fit: cover;
        opacity: 0.35;
    }
    if root.header.has-backdrop: Rectangle {
        background: @linear-gradient(90deg, Theme.bg 0%, #0e0e12cc 45%, #0e0e1200 100%);
    }

    VerticalLayout {
        padding-top: 32px;
        spacing: 20px;

        if root.header-visible: VerticalLayout {
            padding-left: Theme.side-pad;
            padding-right: Theme.side-pad;
            spacing: 8px;
            Text {
                text: root.header.title;
                color: Theme.text;
                font-size: 36px;
                font-weight: 700;
                overflow: elide;
            }
            if root.header.meta != "": Text {
                text: root.header.meta;
                color: Theme.muted;
                font-size: 16px;
            }
            if root.header.info != "": Text {
                text: root.header.info;
                color: #d4d4d8;
                font-size: 14px;
                wrap: word-wrap;
            }
            if root.header.overview != "": Text {
                max-width: 1000px;
                // The whole plot on detail pages; only very long ones elide.
                max-height: 168px;
                text: root.header.overview;
                color: #d4d4d8;
                font-size: 15px;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        rows-area := Rectangle {
            vertical-stretch: 1;
            clip: true;
            rows-layout := VerticalLayout {
                // As much of the row above as fits, never cutting the focused row.
                y: -min(root.scroll-y, max(root.scroll-peek, root.focus-bottom - rows-area.height));
                animate y { duration: 140ms; }
                height: self.preferred-height;
                alignment: start;
                padding-left: Theme.side-pad;
                padding-bottom: 48px;
                spacing: 24px;
                for row[r] in root.rows: VerticalLayout {
                    spacing: 10px;
                    if row.title != "": Text {
                        height: 26px;
                        text: row.title;
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 600;
                    }
                    Rectangle {
                        height: row.style == 2 ? 56px : row.style == 3 ? 72px : (row.style == 1 ? 162px : 240px) + 52px;
                        // Must match layout::pinned_width.
                        property <length> pinned-width: row.pinned > 0 ? row.pinned * (112px + Theme.gap) + Theme.side-pad : 0px;
                        property <int> free: row.cards.length - row.pinned;
                        Rectangle {
                            x: 0;
                            width: parent.width - parent.pinned-width;
                            clip: row.pinned > 0;
                            HorizontalLayout {
                                x: -row.scroll * ((row.style == 1 ? 288px : row.style == 2 ? 220px : row.style == 3 ? 300px : 160px) + Theme.gap);
                                animate x { duration: 140ms; }
                                spacing: Theme.gap;
                                alignment: start;
                                for card[c] in row.cards: CardView {
                                    // Pinned ones are last, so hiding them leaves no gap.
                                    visible: c < free;
                                    card: card;
                                    style: row.style;
                                    focused: r == root.focus-row && c == root.focus-col;
                                    clicked => { root.card-clicked(r, c); }
                                }
                            }
                        }
                        if row.pinned > 0: Rectangle {
                            for card[c] in row.cards: CardView {
                                visible: c >= free;
                                x: parent.width - Theme.side-pad - (row.cards.length - c) * (112px + Theme.gap) + Theme.gap;
                                y: 0;
                                card: card;
                                style: 4;
                                focused: r == root.focus-row && c == root.focus-col;
                                clicked => { root.card-clicked(r, c); }
                            }
                        }
                    }
                }
            }
        }
    }
}

component LoginForm inherits Rectangle {
    in-out property <string> server-url;
    in-out property <string> username;
    in-out property <string> password;
    in property <string> status;
    /// 0 = server url, 1 = username, 2 = password.
    in property <int> first-field;
    callback login();

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 440px;
                spacing: 12px;
                Text {
                    text: "redjelly";
                    font-size: 40px;
                    font-weight: 700;
                    color: Theme.accent;
                    horizontal-alignment: center;
                }
                server := LineEdit {
                    placeholder-text: "Server URL (https://jellyfin.example.com)";
                    text <=> root.server-url;
                    accepted => { user.focus(); }
                }
                user := LineEdit {
                    placeholder-text: "Username";
                    text <=> root.username;
                    accepted => { pass.focus(); }
                }
                pass := LineEdit {
                    placeholder-text: "Password";
                    input-type: InputType.password;
                    text <=> root.password;
                    accepted => { root.login(); }
                }
                Button {
                    text: "Sign in";
                    primary: true;
                    clicked => { root.login(); }
                }
                Text {
                    text: root.status;
                    color: Theme.muted;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Esc: back to the user list";
                    color: #71717a;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    init => {
        if root.first-field == 2 {
            pass.focus();
        } else if root.first-field == 1 {
            user.focus();
        } else {
            server.focus();
        }
    }
}

component PromptView inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> secret;
    in-out property <string> value;
    callback accepted();

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(560px, root.width - 64px);
                spacing: 14px;
                Text {
                    text: root.title;
                    font-size: 28px;
                    font-weight: 700;
                    color: Theme.text;
                }
                if root.description != "": Text {
                    text: root.description;
                    color: Theme.muted;
                    font-size: 15px;
                    wrap: word-wrap;
                }
                input := LineEdit {
                    text <=> root.value;
                    input-type: root.secret ? InputType.password : InputType.text;
                    accepted => { root.accepted(); }
                }
                Text {
                    text: "Enter to save · Esc to cancel";
                    color: #71717a;
                    font-size: 13px;
                }
            }
        }
    }

    init => { input.focus(); }
}

component QuickConnectView inherits Rectangle {
    in property <string> code;
    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 48px;
        Text {
            text: "Quick Connect";
            font-size: 28px;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.code == "" ? "…" : root.code;
            font-size: 72px;
            font-weight: 700;
            letter-spacing: 12px;
            color: Theme.accent;
            horizontal-alignment: center;
        }
        Text {
            text: "On a device where you're signed in, open Jellyfin, go to your profile → Quick Connect, and enter this code.";
            color: Theme.muted;
            font-size: 16px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Text {
            text: "Esc to cancel";
            color: #71717a;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}

// Icons for the player controls, as SVG paths in a 24×24 box. Drawn as
// shapes: symbol glyphs are missing from many fonts.
global Icons {
    out property <string> play: "M 6 3 L 21 12 L 6 21 Z";
    out property <string> pause: "M 5 3 H 10 V 21 H 5 Z M 14 3 H 19 V 21 H 14 Z";
    out property <string> stop: "M 5 5 H 19 V 19 H 5 Z";
    out property <string> rewind: "M 11 5 L 2 12 L 11 19 Z M 21 5 L 12 12 L 21 19 Z";
    out property <string> forward: "M 3 5 L 12 12 L 3 19 Z M 13 5 L 22 12 L 13 19 Z";
    out property <string> previous: "M 4 5 H 7 V 19 H 4 Z M 20 5 L 8 12 L 20 19 Z";
    out property <string> next: "M 17 5 H 20 V 19 H 17 Z M 4 5 L 16 12 L 4 19 Z";
    out property <string> subtitles: "M 2 4 H 22 V 20 H 2 Z M 4 6 V 18 H 20 V 6 Z M 6 13 H 11 V 15 H 6 Z M 13 13 H 18 V 15 H 13 Z M 6 9 H 15 V 11 H 6 Z";
    out property <string> audio: "M 9 5 L 20 3 V 16.5 A 3 3 0 1 1 18 13.7 V 7 L 11 8.3 V 18.5 A 3 3 0 1 1 9 15.7 Z";
    out property <string> speaker: "M 2 9 H 7 L 13 3 V 21 L 7 15 H 2 Z M 16 8 L 17.4 6.6 A 7.5 7.5 0 0 1 17.4 17.4 L 16 16 A 5.5 5.5 0 0 0 16 8 Z";
    out property <string> muted: "M 2 9 H 7 L 13 3 V 21 L 7 15 H 2 Z M 15 9.4 L 16.4 8 L 19 10.6 L 21.6 8 L 23 9.4 L 20.4 12 L 23 14.6 L 21.6 16 L 19 13.4 L 16.4 16 L 15 14.6 L 17.6 12 Z";
    out property <string> fullscreen: "M 3 3 H 10 V 6 H 6 V 10 H 3 Z M 14 3 H 21 V 10 H 18 V 6 H 14 Z M 21 14 V 21 H 14 V 18 H 18 V 14 Z M 10 21 H 3 V 14 H 6 V 18 H 10 Z";
}

/// Focus ids of the player controls; must match src/controls.rs.
global Controls {
    out property <int> stop: 0;
    out property <int> previous: 1;
    out property <int> rewind: 2;
    out property <int> play: 3;
    out property <int> forward: 4;
    out property <int> next: 5;
    out property <int> subtitles: 6;
    out property <int> audio: 7;
    out property <int> volume: 8;
    out property <int> fullscreen: 9;
    out property <int> seek-bar: 10;
}

// One labelled button in the player bar: icon on top, word underneath, so
// nobody has to guess what it does.
component ControlButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> focused;
    in property <length> icon-size: 26px;
    in property <MouseCursor> cursor: MouseCursor.default;
    callback clicked();
    callback hovered();

    width: 76px;
    height: 64px;
    border-radius: 10px;
    background: root.focused ? Theme.accent : touch.pressed ? #ffffff40 : touch.has-hover ? #ffffff22 : transparent;
    animate background { duration: 100ms; }

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        // Same slot for every icon so the labels line up.
        Rectangle {
            height: 32px;
            Path {
                width: root.icon-size;
                height: root.icon-size;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                fill: white;
                fill-rule: evenodd;
            }
        }
        Text {
            text: root.label;
            color: white;
            font-size: 12px;
            font-weight: root.focused ? 700 : 500;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.cursor;
        clicked => { root.clicked(); }
        changed mouse-x => { root.hovered(); }
        changed mouse-y => { root.hovered(); }
    }
}

// Drawn on top of the mpv video. Nothing here may be opaque full-screen,
// or it would hide the video underlay.
component PlayerOverlay inherits Rectangle {
    in property <string> title;
    in property <string> time-text;
    in property <string> total-text;
    in property <float> progress;
    in property <bool> paused;
    in property <bool> osd-visible;
    /// The mouse hasn't moved for a while: hide the cursor, even over the bar.
    in property <bool> pointer-idle;
    in property <string> stats;
    in property <string> skip-label;
    in property <string> next-label;
    /// 0..1 of 100 %.
    in property <float> volume;
    in property <bool> muted;
    in property <bool> has-previous;
    in property <bool> has-next;
    /// Keyboard/controller focus (see `Controls`), -1 = none.
    in property <int> focused-control: -1;
    callback clicked();
    callback double-clicked();
    callback pointer-moved();
    callback button(int);
    /// 0..1 of the duration.
    callback seek(float);
    /// 0..1 of 100 %.
    callback set-volume(float);
    callback skip();

    property <bool> bar-visible: root.osd-visible || root.paused;
    // Hide the cursor while watching (projector-friendly).
    property <MouseCursor> cursor: root.bar-visible && !root.pointer-idle ? MouseCursor.default : MouseCursor.none;

    TouchArea {
        mouse-cursor: root.cursor;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        changed mouse-x => { root.pointer-moved(); }
        changed mouse-y => { root.pointer-moved(); }
    }

    if root.bar-visible: Rectangle {
        y: 0;
        height: 90px;
        background: @linear-gradient(180deg, #000000b0 0%, #00000000 100%);
        Text {
            x: 28px;
            y: 22px;
            width: parent.width - 56px;
            text: root.title;
            color: white;
            font-size: 22px;
            font-weight: 600;
            overflow: elide;
        }
    }

    // Height must match BAR_HEIGHT in src/player_ui.rs.
    if root.bar-visible: Rectangle {
        y: parent.height - 150px;
        height: 150px;
        background: @linear-gradient(0deg, #000000e0 0%, #000000a0 65%, #00000000 100%);

        // Clicks that miss a button must not pause the video.
        TouchArea {
            mouse-cursor: root.cursor;
            changed mouse-x => { root.pointer-moved(); }
            changed mouse-y => { root.pointer-moved(); }
        }

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 12px;
            padding-top: 18px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 14px;
                Text {
                    text: root.time-text;
                    color: white;
                    font-size: 15px;
                    vertical-alignment: center;
                }
                seek-bar := Rectangle {
                    horizontal-stretch: 1;
                    height: 28px;
                    property <bool> active: seek-touch.has-hover || seek-touch.pressed || root.focused-control == Controls.seek-bar;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: seek-bar.active ? 8px : 5px;
                        border-radius: self.height / 2;
                        background: #ffffff40;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.progress, 0, 1);
                            border-radius: parent.border-radius;
                            background: Theme.accent;
                        }
                    }
                    // Where a click would jump to.
                    if seek-touch.has-hover: Rectangle {
                        x: clamp(seek-touch.mouse-x, 0, parent.width) - 1px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: 14px;
                        background: #ffffffa0;
                    }
                    Rectangle {
                        property <length> size: root.focused-control == Controls.seek-bar ? 22px : seek-bar.active ? 16px : 12px;
                        x: parent.width * clamp(root.progress, 0, 1) - self.size / 2;
                        y: (parent.height - self.size) / 2;
                        width: self.size;
                        height: self.size;
                        border-radius: self.size / 2;
                        background: white;
                        border-width: root.focused-control == Controls.seek-bar ? 4px : 0px;
                        border-color: Theme.accent;
                    }
                    seek-touch := TouchArea {
                        mouse-cursor: root.cursor;
                        clicked => { root.seek(clamp(self.mouse-x / self.width, 0, 1)); }
                        moved => {
                            if (self.pressed) {
                                root.seek(clamp(self.mouse-x / self.width, 0, 1));
                            }
                        }
                        changed mouse-x => { root.pointer-moved(); }
                    }
                }
                Text {
                    text: root.total-text;
                    color: #d4d4d8;
                    font-size: 15px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 4px;
                ControlButton {
                    icon: Icons.stop;
                    label: "Stop";
                    focused: root.focused-control == Controls.stop;
                    icon-size: 22px;
                    clicked => { root.button(Controls.stop); }
                    cursor: root.cursor;
                    hovered => { root.pointer-moved(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.has-previous: ControlButton {
                    icon: Icons.previous;
                    label: "Previous";
                    focused: root.focused-control == Controls.previous;
                    clicked => { root.button(Controls.previous); }
                    cursor: root.cursor;
                    hovered => { root.pointer-moved(); }
                }
                ControlButton {
                    icon: Icons.rewind;
                    label: "Back 10s";
                    focused: root.focused-control == Controls.rewind;
                    clicked => { root.button(Controls.rewind); }
                    cursor: root.cursor;
                    hovered => { root.pointer-moved(); }
                }
                ControlButton {
                    icon: root.paused ? Icons.play : Icons.pause;
                    label: root.paused ? "Play" : "Pause";
                    focused: root.focused-control == Controls.play;
                    icon-size: 32px;
                    clicked => { root.button(Controls.play); }
                    cursor: root.cursor;
                    hovered => { root.pointer-moved(); }
                }
                ControlButton {
                    icon: Icons.forward;
                    label: "Ahead 30s";
                    focused: root.focused-control == Controls.forward;
                    clicked => { root.button(Controls.forward); }
                    cursor: root.cursor;
                    hovered => { root.pointer-moved(); }
                }
                if root.has-next: ControlButton {
                    icon: Icons.next;
                    label: "Next";
                    focused: root.focused-control == Controls.next;
                    clicked => { root.button(Controls.next); }
                    cursor: root.cursor;
                    hovered => { root.pointer-moved(); }
                }
                Rectangle { horizontal-stretch: 1; }
                ControlButton {
                    icon: Icons.subtitles;
                    label: "Subtitles";
                    focused: root.focused-control == Controls.subtitles;
                    clicked => { root.button(Controls.subtitles); }
                    cursor: root.cursor;
                    hovered => { root.pointer-moved(); }
                }
                ControlButton {
                    icon: Icons.audio;
                    label: "Audio";
                    focused: root.focused-control == Controls.audio;
                    clicked => { root.button(Controls.audio); }
                    cursor: root.cursor;
                    hovered => { root.pointer-moved(); }
                }
                ControlButton {
                    icon: root.muted ? Icons.muted : Icons.speaker;
                    label: root.muted ? "Muted" : "Volume";
                    focused: root.focused-control == Controls.volume;
                    clicked => { root.button(Controls.volume); }
                    cursor: root.cursor;
                    hovered => { root.pointer-moved(); }
                }
                // Mouse/touch only; keys use Up/Down while the bar is hidden.
                if root.width >= 900px: Rectangle {
                    width: 96px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 5px;
                        border-radius: 2.5px;
                        background: #ffffff40;
                        Rectangle {
                            x: 0;
                            width: parent.width * (root.muted ? 0 : clamp(root.volume, 0, 1));
                            border-radius: parent.border-radius;
                            background: white;
                        }
                    }
                    TouchArea {
                        mouse-cursor: root.cursor;
                        clicked => { root.set-volume(clamp(self.mouse-x / self.width, 0, 1)); }
                        moved => {
                            if (self.pressed) {
                                root.set-volume(clamp(self.mouse-x / self.width, 0, 1));
                            }
                        }
                        changed mouse-x => { root.pointer-moved(); }
                    }
                }
                ControlButton {
                    icon: Icons.fullscreen;
                    label: "Full screen";
                    focused: root.focused-control == Controls.fullscreen;
                    icon-size: 22px;
                    clicked => { root.button(Controls.fullscreen); }
                    cursor: root.cursor;
                    hovered => { root.pointer-moved(); }
                }
            }
        }
    }

    if root.next-label != "": Rectangle {
        x: parent.width - self.width - 32px;
        y: parent.height - self.height - 170px;
        width: min(560px, parent.width - 64px);
        height: next-text.preferred-height + 32px;
        border-radius: 10px;
        background: #000000d8;
        border-width: 2px;
        border-color: Theme.accent;
        next-text := Text {
            x: 20px;
            width: parent.width - 40px;
            text: root.next-label;
            color: white;
            font-size: 17px;
            wrap: word-wrap;
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.skip(); }
        }
    }

    if root.skip-label != "": Rectangle {
        x: parent.width - self.width - 32px;
        y: parent.height - 170px - self.height;
        width: skip-text.preferred-width + 40px;
        height: 48px;
        border-radius: 8px;
        background: skip-touch.has-hover ? white : #ffffffe6;
        skip-text := Text {
            text: root.skip-label;
            color: black;
            font-size: 16px;
            font-weight: 600;
        }
        skip-touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.skip(); }
        }
    }

    if root.stats != "": Rectangle {
        x: 16px;
        y: 80px;
        width: stats-text.preferred-width + 24px;
        height: stats-text.preferred-height + 24px;
        background: #000000b0;
        border-radius: 6px;
        stats-text := Text {
            x: 12px;
            y: 12px;
            text: root.stats;
            color: white;
            font-size: 13px;
            font-family: "Consolas";
        }
    }
}

// Right-hand drawer over the video (Subtitles / Audio buttons, or S).
component SubtitlePanel inherits Rectangle {
    in property <string> title;
    in property <string> status;
    in property <[PanelItem]> items;
    in property <int> current;
    callback item-clicked(int);
    callback close();

    background: #0b0b0efc;

    TouchArea { }

    VerticalLayout {
        padding: 28px;
        spacing: 12px;
        HorizontalLayout {
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 24px;
                font-weight: 700;
                horizontal-stretch: 1;
            }
            Rectangle {
                width: close-text.preferred-width + 28px;
                height: 36px;
                border-radius: 18px;
                background: close-touch.has-hover ? #ffffff30 : #ffffff1a;
                close-text := Text {
                    text: "Close";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                }
                close-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.close(); }
                }
            }
        }
        Text {
            text: root.status;
            color: Theme.muted;
            font-size: 14px;
            wrap: word-wrap;
        }
        list := Rectangle {
            vertical-stretch: 1;
            clip: true;
            property <length> item-h: 60px;
            VerticalLayout {
                // Keep the focused line roughly centred.
                y: -max(0px, min(root.current * list.item-h - list.height / 2 + list.item-h, root.items.length * list.item-h - list.height));
                animate y { duration: 120ms; }
                height: root.items.length * list.item-h;
                for item[i] in root.items: Rectangle {
                    height: list.item-h;
                    border-radius: 6px;
                    background: i == root.current && !item.header ? Theme.accent : transparent;
                    if item.header: Text {
                        x: 4px;
                        y: parent.height - self.height - 6px;
                        text: item.title;
                        color: Theme.muted;
                        font-size: 13px;
                        font-weight: 700;
                    }
                    if !item.header: HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: item.title;
                                color: item.dimmed ? #71717a : Theme.text;
                                font-size: 15px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            if item.detail != "": Text {
                                text: item.detail;
                                color: i == root.current ? #ffffffd0 : Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                        if item.badge != "": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: badge-text.preferred-width + 14px;
                                height: 22px;
                                border-radius: 11px;
                                background: i == root.current ? #ffffff40 : #ffffff1a;
                                badge-text := Text {
                                    text: item.badge;
                                    color: Theme.text;
                                    font-size: 11px;
                                    font-weight: 600;
                                }
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.item-clicked(i); }
                    }
                }
            }
        }
        Text {
            text: "↑↓ choose · Enter select · Esc close";
            color: #71717a;
            font-size: 12px;
        }
    }
}

component KeyHelpOverlay inherits Rectangle {
    in property <string> title;
    in property <[KeyHelp]> keys;
    background: #0b0b0ef8;

    TouchArea { }

    VerticalLayout {
        padding: 48px;
        spacing: 20px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 26px;
            font-weight: 700;
        }
        keys-area := Rectangle {
            vertical-stretch: 1;
            // Three columns, filled top to bottom.
            property <int> per-col: max(1, ceil(root.keys.length / 3));
            property <length> col-w: (self.width - 2 * 24px) / 3;
            for k[i] in root.keys: Rectangle {
                x: floor(i / keys-area.per-col) * (keys-area.col-w + 24px);
                y: mod(i, keys-area.per-col) * 26px;
                width: keys-area.col-w;
                height: 26px;
                Text {
                    x: 0;
                    width: 130px;
                    text: k.key;
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: right;
                }
                Text {
                    x: 142px;
                    width: parent.width - 142px;
                    text: k.action;
                    color: #e4e4e7;
                    font-size: 14px;
                    overflow: elide;
                }
            }
        }
        Text {
            text: "Press any key to close";
            color: Theme.muted;
            font-size: 13px;
        }
    }
}

export component AppWindow inherits Window {
    title: "redjelly";
    icon: @image-url("icon.png");
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 400px;
    /// mpv draws in its own window behind this one: the player screen
    /// must be see-through.
    in property <bool> video-behind;
    background: root.screen == 2 && root.video-behind ? transparent : Theme.bg;

    /// 1 = browse, 2 = player, 3 = login form, 4 = quick connect, 5 = prompt.
    in property <int> screen: 1;

    // Browse
    in property <Header> header;
    in property <bool> header-visible;
    in property <[Row]> rows;
    in property <int> focus-row;
    in property <int> focus-col;
    in property <length> scroll-y;
    in property <length> scroll-peek;
    in property <length> focus-bottom;

    // Login
    in-out property <string> server-url;
    in-out property <string> username;
    in-out property <string> password;
    in property <string> status;
    in property <int> login-first-field;
    in property <string> quick-connect-code;

    // Player
    in property <string> player-title;
    in property <string> player-time;
    in property <string> player-total;
    in property <float> player-progress;
    in property <bool> player-paused;
    in property <bool> player-osd;
    in property <bool> player-pointer-idle;
    in property <string> player-stats;
    in property <string> player-skip;
    in property <string> player-next;
    in property <float> player-volume;
    in property <bool> player-muted;
    in property <bool> player-has-previous;
    in property <bool> player-has-next;
    in property <int> player-focus: -1;

    // Prompt (text input for settings)
    in property <string> prompt-title;
    in property <string> prompt-description;
    in property <bool> prompt-secret;
    in-out property <string> prompt-value;

    // Subtitle panel
    in property <bool> panel-visible;
    in property <string> panel-title;
    in property <string> panel-status;
    in property <[PanelItem]> panel-items;
    in property <int> panel-focus;

    // Overlays
    in property <string> toast;
    in property <bool> keyhelp-visible;
    in property <string> keyhelp-title;
    in property <[KeyHelp]> keyhelp;

    callback login();
    /// (text, ctrl, alt, shift) -> handled
    callback key(string, bool, bool, bool) -> bool;
    callback card-clicked(int, int);
    callback player-clicked();
    callback player-double-clicked();
    callback player-pointer-moved();
    callback player-button(int);
    callback player-seek(float);
    callback player-set-volume(float);
    callback player-skip-clicked();
    callback panel-item-clicked(int);
    callback panel-close();
    callback prompt-accepted();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            // In the login form the line edits own the keyboard; only Esc
            // bubbles up to here.
            if ((root.screen == 3 || root.screen == 5) && event.text != Key.Escape) {
                return reject;
            }
            return root.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift) ? accept : reject;
        }

        if root.screen == 1: BrowseView {
            header: root.header;
            header-visible: root.header-visible;
            rows: root.rows;
            focus-row: root.focus-row;
            focus-col: root.focus-col;
            scroll-y: root.scroll-y;
            scroll-peek: root.scroll-peek;
            focus-bottom: root.focus-bottom;
            card-clicked(r, c) => { root.card-clicked(r, c); }
        }
        if root.screen == 2: PlayerOverlay {
            title: root.player-title;
            time-text: root.player-time;
            total-text: root.player-total;
            progress: root.player-progress;
            paused: root.player-paused;
            osd-visible: root.player-osd;
            pointer-idle: root.player-pointer-idle;
            stats: root.player-stats;
            skip-label: root.player-skip;
            next-label: root.player-next;
            volume: root.player-volume;
            muted: root.player-muted;
            has-previous: root.player-has-previous;
            has-next: root.player-has-next;
            focused-control: root.player-focus;
            clicked => { root.player-clicked(); }
            double-clicked => { root.player-double-clicked(); }
            pointer-moved => { root.player-pointer-moved(); }
            button(b) => { root.player-button(b); }
            seek(f) => { root.player-seek(f); }
            set-volume(f) => { root.player-set-volume(f); }
            skip => { root.player-skip-clicked(); }
        }
        if root.screen == 3: LoginForm {
            server-url <=> root.server-url;
            username <=> root.username;
            password <=> root.password;
            status: root.status;
            first-field: root.login-first-field;
            login => { root.login(); }
        }
        if root.screen == 4: QuickConnectView {
            code: root.quick-connect-code;
        }
        if root.screen == 5: PromptView {
            title: root.prompt-title;
            description: root.prompt-description;
            secret: root.prompt-secret;
            value <=> root.prompt-value;
            accepted => { root.prompt-accepted(); }
        }
    }

    if root.panel-visible: SubtitlePanel {
        x: parent.width - self.width;
        width: min(600px, parent.width * 0.5);
        title: root.panel-title;
        status: root.panel-status;
        items: root.panel-items;
        current: root.panel-focus;
        item-clicked(i) => { root.panel-item-clicked(i); }
        close => { root.panel-close(); }
    }

    if root.keyhelp-visible: KeyHelpOverlay {
        title: root.keyhelp-title;
        keys: root.keyhelp;
    }

    // Top-centre so it never covers the player's bottom bar.
    if root.toast != "": Rectangle {
        y: 24px;
        width: min(parent.width - 48px, toast-text.preferred-width + 32px);
        height: toast-text.preferred-height + 20px;
        border-radius: 8px;
        background: #000000c8;
        toast-text := Text {
            width: parent.width - 32px;
            text: root.toast;
            color: white;
            font-size: 15px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }

    public function focus-keys() {
        keys.focus();
    }
}
